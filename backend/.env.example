APP_NAME=NumCounts
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+asyncmy://numcounts_app:change-me@mysql:3306/numcounts
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-admin-password-before-production
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=change-user-password-before-production
SEED_USER_TEACHER_ID=user
EXTERNAL_EXECUTORS=[]
CORS_ORIGINS=["http://127.0.0.1:4173","http://localhost:4173"]
